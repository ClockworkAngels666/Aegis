# All optional. Without them the app runs on the bundled snapshots.

# UN Comtrade subscription key (free tier): makes the fallback trade source a
# single call. Eurostat, the primary source, needs no key.
COMTRADE_API_KEY=

# OpenSanctions API key: /match screening instead of the bundled official lists
# (OpenSanctions' own licence terms apply).
OPENSANCTIONS_API_KEY=

# Upstash Redis (REST): shared cache for live responses across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any OpenAI-compatible chat-completions endpoint for the optional memo narrative.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
